# Copy this file to .env and fill in your values for local development.
# .env is in .gitignore — never commit real secrets.

# Required in production; optional locally (falls back to an insecure default)
SECRET_KEY=your-secret-key-here

# Set to True for local development only
DEBUG=True

# Leave unset locally to use SQLite.
# Render sets this automatically when you attach a PostgreSQL database.
# DATABASE_URL=postgres://user:password@host:5432/dbname

# Snowflake — optional, prices are skipped if not set
# SNOWFLAKE_ACCOUNT=your-account-identifier
# SNOWFLAKE_USER=your-username
# SNOWFLAKE_PASSWORD=your-password
# SNOWFLAKE_DATABASE=STOCK_TRACKER
# SNOWFLAKE_SCHEMA=PUBLIC
# SNOWFLAKE_WAREHOUSE=STOCK_TRACKER_WH
